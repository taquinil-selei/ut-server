# Copy to .env and edit.
SERVER_NAME=My UT2004 Server
# Required for WebAdmin and in-game "admin login". Pick a long random value.
ADMIN_PASSWORD=
# Leave empty for a public server.
GAME_PASSWORD=
MAX_PLAYERS=16
START_MAP=DM-Rankin
GAME_TYPE=XGame.xDeathMatch
# WebAdmin listens on WEBADMIN_PORT (TCP). Keep that port closed in the firewall
# and reach it through an SSH tunnel: ssh -L 8075:localhost:8075 root@<server>
WEBADMIN=false
WEBADMIN_PORT=8075
# Extra ucc-bin arguments, e.g. "-lanplay" for a private test.
EXTRA_ARGS=
